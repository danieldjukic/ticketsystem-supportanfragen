# PostgreSQL-Verbindung (Neon-Connection String oder lokal)
DATABASE_URL=postgres://user:password@localhost:5432/ticketing

# Eigene Testdatenbank, zwingend fuer Integrationstests (NODE_ENV=test, kein Fallback auf DATABASE_URL)
TEST_DATABASE_URL=postgres://user:password@localhost:5432/ticketing_test

# Secret für JWT-Signierung (min. 32 Zeichen, nie hart codieren)
JWT_SECRET=replace-with-long-random-secret

# Port des HTTP-Servers (Basis-URL im Dev: http://localhost:3000)
PORT=3000
CORS_ORIGINS=http://localhost:4200
